# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Public URL of the website, used in email links
# @public @type=url
PUBLIC_SITE_URL=http://localhost:3001

# Resend API key. When empty, emails are printed to the console instead of sent.
# @optional
RESEND_API_KEY=

# Sender address, must be on a domain verified in Resend
# @public
MAIL_FROM="Koirankoulutus Nyt ja Tässä <onboarding@resend.dev>"

# Where new course requests are notified
# @public @type=email
TRAINER_EMAIL=teija@example.com

# Admin account, created at server start if it does not exist
# @public @type=email
ADMIN_EMAIL=teija@example.com

# @type=string(minLength=8)
ADMIN_PASSWORD=
